[Unit]
Description=Soberano Dotfiles Background Sync & Auto-Updater
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/dotfiles/scripts/soberano-update.sh --background
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
