#!/usr/bin/env python3
# language: Python, file: strike, target: CachyOS / Linux
# Orchestrator: Qwen3-Coder (30B MoE) Planner + DeepHat (7B) Operator

import sys
import os
import re
import json
import subprocess
import urllib.request
from urllib.parse import urlparse

OLLAMA_API = "http://127.0.0.1:11434/api/generate"
PLANNER_MODEL = "qwen3-coder:30b"
OPERATOR_MODEL = "deephat"

# ANSI Colors
CLR_RESET = "\033[0m"
CLR_BOLD = "\033[1m"
CLR_CYAN = "\033[36m"
CLR_GREEN = "\033[32m"
CLR_YELLOW = "\033[33m"
CLR_RED = "\033[31m"
CLR_MAGENTA = "\033[35m"

def query_ollama(model: str, prompt: str, system: str = "", stream: bool = False, temperature: float = 0.2):
    payload = {
        "model": model,
        "prompt": prompt,
        "stream": stream,
        "options": {"temperature": temperature, "num_predict": 1024, "repeat_penalty": 1.15}
    }
    if system:
        payload["system"] = system
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(OLLAMA_API, data=data, headers={"Content-Type": "application/json"})
    return urllib.request.urlopen(req)

def sanitize_target_in_text(text: str) -> str:
    # Convert full URLs like https://www.example.com/path to clean hostnames www.example.com
    def replace_url(match):
        raw_url = match.group(0)
        try:
            parsed = urlparse(raw_url if "://" in raw_url else "http://" + raw_url)
            host = parsed.netloc or parsed.path
            return host.split("/")[0].rstrip("/")
        except:
            return raw_url
    
    return re.sub(r"https?://[^\s'\"]+", replace_url, text)

def extract_bash_command(text: str, default_domain: str = "") -> str:
    # Check for markdown code blocks first
    code_match = re.search(r"```(?:bash|sh)?\s*\n(.*?)\n```", text, re.DOTALL)
    if code_match:
        lines = [l.strip() for l in code_match.group(1).strip().splitlines() if l.strip() and not l.strip().startswith("#")]
        if lines:
            return lines[0]
    # Check lines for common cli commands
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    for line in lines:
        cleaned = re.sub(r"^[`'\"]+|[`'\"]+$", "", line).strip()
        if any(cleaned.startswith(tool) for tool in ["dig", "host", "nslookup", "nmap", "curl", "ping", "whois", "traceroute", "netstat", "ss", "ip", "cat", "find"]):
            return cleaned
    if lines:
        candidate = lines[0].strip("`'\"")
        if candidate:
            return candidate
    if default_domain:
        return f"dig +short {default_domain}"
    return ""

def execute_strike(raw_task: str):
    user_task = sanitize_target_in_text(raw_task)
    print(f"\n{CLR_MAGENTA}{CLR_BOLD}[AI STRIKE // DUAL AGENT]{CLR_RESET} Tarefa: {CLR_BOLD}{user_task}{CLR_RESET}")
    
    recon_keywords = ["ip", "dns", "porta", "port", "scan", "varr", "extra", "host", "ping", "whois", "nmap", "rede", "servico", "curl"]
    is_tactical = any(kw in user_task.lower() for kw in recon_keywords)
    
    if is_tactical:
        # Extract potential domain for fallback
        domains = re.findall(r"([a-zA-Z0-9][-a-zA-Z0-9]*\.(?:[a-zA-Z0-9][-a-zA-Z0-9]*\.)*[a-zA-Z]{2,})", user_task)
        clean_domain = domains[0] if domains else ""

        print(f"{CLR_CYAN}>> [1/3] DeepHat acionado: gerando comando tático...{CLR_RESET}")
        
        deep_system = (
            "You are DeepHat offensive engine. Return ONLY the exact, single-line bash command "
            "needed to execute the reconnaissance, DNS resolution, port scan, or inspection requested. "
            "RULES: "
            "1. To get an IP or DNS of a domain or website, ALWAYS use: dig +short <clean_domain> (or host <clean_domain>). "
            "NEVER use curl to download web pages when resolving IP addresses! "
            "2. Zero explanations, zero conversational fluff, zero placeholders like TARGET_URL or IP_ADDRESS. "
            "3. Output ONLY the bash command."
        )
        
        try:
            res = query_ollama(OPERATOR_MODEL, f"Gere o comando bash para: {user_task}", system=deep_system, stream=False, temperature=0.1)
            raw_response = json.loads(res.read().decode("utf-8"))["response"]
            cmd = extract_bash_command(raw_response, default_domain=clean_domain)
        except Exception as e:
            print(f"{CLR_RED}[!] Erro ao chamar DeepHat: {e}{CLR_RESET}")
            cmd = f"dig +short {clean_domain}" if clean_domain else ""

        if not cmd and clean_domain:
            cmd = f"dig +short {clean_domain}"

        # Clean any accidental https:// inside the command if using dig/host
        if cmd.startswith("dig") or cmd.startswith("host") or cmd.startswith("nslookup"):
            cmd = re.sub(r"https?://", "", cmd).rstrip("/")

        if cmd:
            print(f"{CLR_GREEN}>> [2/3] Executando no Linux:{CLR_RESET} {CLR_BOLD}{cmd}{CLR_RESET}")
            try:
                proc = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=30)
                stdout = proc.stdout.strip()
                stderr = proc.stderr.strip()
                output = stdout if stdout else stderr
                
                # If curl was attempted or output is empty, fallback to dig
                if not output and clean_domain:
                    fallback_cmd = f"dig +short {clean_domain}"
                    proc_fb = subprocess.run(fallback_cmd, shell=True, capture_output=True, text=True, timeout=10)
                    fb_out = proc_fb.stdout.strip()
                    if fb_out:
                        output = fb_out
                        cmd = fallback_cmd
                
                if not output:
                    output = "[Sem saida do comando / OK]"
            except subprocess.TimeoutExpired:
                output = "[Erro: Tempo limite de execucao expirado (30s)]"
            except Exception as e:
                output = f"[Erro de execucao: {e}]"
            
            # Print preview of real output
            preview = output[:300] + ("..." if len(output) > 300 else "")
            print(f"{CLR_YELLOW}>> [Dados Reais Capturados]:{CLR_RESET}\n{preview}\n")
            
            # Phase 3: Qwen3-Coder synthesis
            print(f"{CLR_CYAN}>> [3/3] Qwen3-Coder sintetizando analise...{CLR_RESET}\n")
            qwen_prompt = (
                f"O operador solicitou: {user_task}\n"
                f"Comando executado: {cmd}\n"
                f"Saida real obtida no sistema:\n{output}\n\n"
                "Sintetize e explique os dados reais de forma direta, tecnica e precisa para o operador. "
                "CRITICO: Nunca use placeholders ficticios (como TARGET_URL, 192.0.2.1 ou IP_ADDRESS); use os dados reais obtidos acima."
            )
        else:
            qwen_prompt = user_task
    else:
        qwen_prompt = user_task

    # Stream Qwen response
    try:
        synthesizer = OPERATOR_MODEL if is_tactical else PLANNER_MODEL
        response_stream = query_ollama(synthesizer, qwen_prompt, stream=True, temperature=0.3)
        print(f"{CLR_BOLD}", end="")
        for line in response_stream:
            if line:
                chunk = json.loads(line.decode("utf-8"))
                sys.stdout.write(chunk.get("response", ""))
                sys.stdout.flush()
        print(f"{CLR_RESET}\n")
    except Exception as e:
        print(f"\n{CLR_RED}[!] Erro no Qwen3-Coder: {e}{CLR_RESET}")

def main():
    if len(sys.argv) > 1:
        task = " ".join(sys.argv[1:])
        execute_strike(task)
    else:
        print(f"{CLR_MAGENTA}{CLR_BOLD}=== STRIKE: Qwen3-Coder (30B) + DeepHat (7B) Dual Agent ==={CLR_RESET}")
        print("Digite sua ordem ou 'sair' para encerrar.\n")
        while True:
            try:
                task = input(f"{CLR_GREEN}strike >> {CLR_RESET}").strip()
                if not task:
                    continue
                if task.lower() in ["exit", "sair", "quit", "q"]:
                    break
                execute_strike(task)
            except KeyboardInterrupt:
                print("\nEncerrando.")
                break

if __name__ == "__main__":
    main()
